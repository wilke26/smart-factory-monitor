# Copy this file to .env to override Docker Compose defaults.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_QOS=1
MQTT_CLIENT_ID=smart-factory-simulator
MQTT_CONSUMER_CLIENT_ID=smart-factory-consumer
MQTT_TOPIC_FILTER=factory/+/+/telemetry
MQTT_SESSION_EXPIRY_SECONDS=86400
MQTT_RECEIVE_MAXIMUM=20
# Generic credentials used when running an entry point outside Compose.
MQTT_USERNAME=
MQTT_PASSWORD=
# Separate loopback-only Compose identities and development credentials.
SIMULATOR_MQTT_USERNAME=smart-factory-simulator
SIMULATOR_MQTT_PASSWORD=simulator_dev
CONSUMER_MQTT_USERNAME=smart-factory-consumer
CONSUMER_MQTT_PASSWORD=consumer_dev
MQTT_TLS_ENABLED=false
MQTT_TLS_CA_CERT_PATH=
MQTT_TLS_CLIENT_CERT_PATH=
MQTT_TLS_CLIENT_KEY_PATH=
FACTORY_AREA=hall-a
MACHINE_ID=press-01
PUBLISH_INTERVAL_SECONDS=2.0
# Leave empty for non-deterministic values; use an integer for repeatable runs.
SIMULATOR_SEED=
LOG_LEVEL=INFO
POSTGRES_DB=smart_factory
POSTGRES_USER=smart_factory
# Development-only credential; use secret management outside local Compose.
POSTGRES_PASSWORD=smart_factory_dev
DATABASE_URL=postgresql://smart_factory:smart_factory_dev@timescaledb:5432/smart_factory
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=4
DATABASE_CONNECT_TIMEOUT_SECONDS=10.0
ANOMALY_MAX_TEMPERATURE_C=90.0
ANOMALY_MAX_VIBRATION_MM_S=7.0
ANOMALY_MAX_POWER_KW=30.0
ANOMALY_MIN_PRODUCTION_RATE=25
ML_ANOMALY_DETECTION_ENABLED=false
ML_MODEL_DIRECTORY=/models
ML_MACHINE_IDS=press-01
ML_CONTAMINATION=0.05
ML_MINIMUM_TRAINING_SAMPLES=100
ML_TRAINING_LIMIT=10000
ML_EVALUATION_MINIMUM_SAMPLES=30
ML_EVALUATION_LIMIT=1000
ML_MAX_EVALUATION_ANOMALY_RATE=0.15
ML_MAX_FEATURE_PSI=0.25
# Required by direct non-Compose ML training/evaluation/promotion/inference; Compose manages local keys.
ML_SIGNING_PRIVATE_KEY_PATH=
ML_SIGNATURE_PUBLIC_KEY_PATH=
# Required for model promotion and rollback. Production automation must inject a trusted identity.
AUDIT_ACTOR=
AUDIT_REASON=
AUDIT_CORRELATION_ID=
# Signed checkpoint identity and output. Compose manages local attestation keys.
AUDIT_CHAIN_ID=smart-factory-local
AUDIT_CHECKPOINT_PATH=/audit-checkpoints/checkpoint.json
AUDIT_ATTESTATION_PRIVATE_KEY_PATH=
AUDIT_ATTESTATION_PUBLIC_KEY_PATH=
AUDIT_ATTESTATION_KEYRING_PATH=
# Required by verification and rotation in production; inject from an independent secret.
AUDIT_ATTESTATION_TRUSTED_ROOT_KEY_ID=
# Required for rotation; copy from a separately reviewed keyring verification result.
AUDIT_ATTESTATION_EXPECTED_ACTIVE_KEY_ID=
# Development-only fallback. Never enable this for a production trust boundary.
AUDIT_ATTESTATION_ROOT_KEY_ID_PATH=
AUDIT_ATTESTATION_ALLOW_COLOCATED_ROOT=false
ALERT_WEBHOOK_URL=
# Development only. Production webhooks must use verified HTTPS.
ALERT_WEBHOOK_ALLOW_INSECURE_HTTP=false
ALERT_WEBHOOK_BEARER_TOKEN=
ALERT_WEBHOOK_CA_CERT_PATH=
ALERT_MINIMUM_SEVERITY=high
ALERT_BATCH_SIZE=20
ALERT_POLL_INTERVAL_SECONDS=2.0
ALERT_REQUEST_TIMEOUT_SECONDS=5.0
ALERT_LEASE_SECONDS=120
ALERT_RETRY_BASE_SECONDS=5.0
ALERT_RETRY_MAX_SECONDS=300.0
MONITORING_HOST=127.0.0.1
MONITORING_PORT=8000
MONITORING_HOST_PORT=8000
# Recovery tools write versioned bundles below this host directory.
BACKUP_DIRECTORY=./backups
# Set explicitly when running backup-create or backup-restore.
BACKUP_ID=
# Restores are deliberately isolated from the active database.
RESTORE_DATABASE_NAME=smart_factory_restore
